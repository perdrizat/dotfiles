{
  "permissions": {
    "allow": [
      "Bash(pre_commit_check.sh*)",
      "Bash(validate_setup.sh*)",
      "Bash(validate_project.sh*)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:fast *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm test:uat *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/bin/check_changelog.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/bin/claude_status.sh"
  },
  "terminalTitleFromRename": true,
  "autoMemoryEnabled": true,
  "remoteControlAtStartup": true,
  "model": "opus"
}
