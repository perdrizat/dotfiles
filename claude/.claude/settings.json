{
  "permissions": {
    "allow": [
      "Bash(pnpm audit:*)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm test:fast *)",
      "Bash(pnpm test:uat *)",
      "Bash(pnpm typecheck)",
      "Bash(pre_commit_check.sh*)",
      "Bash(validate_project.sh*)",
      "Bash(validate_setup.sh*)",
      "WebFetch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/bin/check_changelog.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/bin/claude_status.sh"
  },
  "spinnerTipsEnabled": false,
  "awaySummaryEnabled": false,
  "feedbackSurveyRate": 0,
  "terminalTitleFromRename": true,
  "autoMemoryEnabled": true,
  "remoteControlAtStartup": true,
  "model": "opus"
}
