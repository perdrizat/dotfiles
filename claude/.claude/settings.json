{
  "permissions": {
    "allow": [
      "Bash(pre_commit_check.sh*)",
      "Bash(validate_setup.sh*)",
      "Bash(validate_project.sh*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\e]0;%s@%s: %s\\a' \"$USER\" \"${WSL_DISTRO_NAME:-$(hostname -s)}\" \"$PWD\" >&2"
          },
          {
            "type": "command",
            "command": "bash ~/bin/check_changelog.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/bin/claude_status.sh"
  },
  "terminalTitleFromRename": true,
  "autoMemoryEnabled": true
}
