# PATH for local files
for dir in ~/.local/bin ~/bin; do
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) PATH="$dir:$PATH" ;;
    esac
done
export PATH

# Collapse duplicate PATH entries, keeping the first occurrence so precedence is
# unchanged. Needed because third-party installers (fnm, Antigravity, rustup, …) append
# unconditional `PATH=…:$PATH` lines to ~/.bashrc and ~/.profile — files that re-run for
# every shell — so nested login shells (terminal → tmux) multiply entries. The guard
# above only governs our own two dirs; this cleans up after everyone else's.
# setup.sh keeps a call to this as the last line of both startup files.
# Empty fields are dropped: `::` or a trailing `:` means "current directory", which is a
# security hazard and effectively always an accident.
# Pure shell parameter expansion — no fork, and no globbing of PATH entries.
path_dedup() {
    local out="" seen=":" rest="$PATH" dir
    while [ -n "$rest" ]; do
        dir="${rest%%:*}"
        if [ "$rest" = "$dir" ]; then rest=""; else rest="${rest#*:}"; fi
        [ -n "$dir" ] || continue
        case "$seen" in *":$dir:"*) continue ;; esac
        seen="$seen$dir:"
        out="${out:+$out:}$dir"
    done
    PATH="$out"
    export PATH
}

# Fallback to vi if vim is not installed
if command -v vim >/dev/null 2>&1; then
    export EDITOR='vim'
else
    alias vim='vi'
    export EDITOR='vi'
fi
export VISUAL="$EDITOR"

# for Claude Code & Gemini
export COLORTERM=truecolor
export FORCE_COLOR=3

# Only cd to home if we are currently in a Windows drive mapping
if [[ "$PWD" == "/mnt/c/Users/mperd" ]]; then
    cd ~
fi

# --- Windows ssh-agent (YubiKey) relay ---
# Config is generated per-host by wsl_ssh_agent.sh. Guarded so this is a silent
# no-op on non-WSL hosts or before the relay has been provisioned.
if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -f "$HOME/.config/dotfiles/ssh_agent.env" ]; then
    . "$HOME/.config/dotfiles/ssh_agent.env"   # sets NPIPERELAY, exports SSH_AUTH_SOCK
    if [ -n "${NPIPERELAY:-}" ] && [ -x "$NPIPERELAY" ] && command -v socat >/dev/null 2>&1; then
        if [ ! -S "$SSH_AUTH_SOCK" ] || ! pgrep -f "socat.*$SSH_AUTH_SOCK" >/dev/null; then
            pkill -f "socat.*$SSH_AUTH_SOCK" 2>/dev/null
            rm -f "$SSH_AUTH_SOCK"
            (setsid socat UNIX-LISTEN:"$SSH_AUTH_SOCK",fork \
                EXEC:"$NPIPERELAY -ei -s //./pipe/openssh-ssh-agent",nofork & ) >/dev/null 2>&1
        fi
    fi
fi

# Custom prompt for WSL
if [ -n "$WSL_DISTRO_NAME" ]; then
    # Default Maol prompt style, but with WSL name
    export PS1="\[\e]0;\u@$WSL_DISTRO_NAME: \w\a\]${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@$WSL_DISTRO_NAME\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "
fi
