# Machine-specific setup configuration
# Edit this file to customize your installation
# All toggles default to false; set to true to enable

# Dev toolchain toggles
INSTALL_RUST=false       # rustup → cargo, rustc, rustfmt, clippy
INSTALL_NODE=false       # fnm → latest LTS Node + npm
INSTALL_ICP=false        # dfxvm → dfx + ic-admin
INSTALL_PYTHON=false     # apt python3 + python3-venv
INSTALL_DOCKER=false     # apt docker-compose-v2
INSTALL_FF=false         # Mozilla apt repo → firefox (latest)
INSTALL_FF_ESR=false     # Mozilla apt repo → firefox-esr
# Note: for now either Firefox toggle installs & checks both the latest and ESR builds
INSTALL_CHROME=false     # Google apt repo → google-chrome-stable (amd64 only)

# LLM agent toggles
INSTALL_CLAUDE=true     # Claude Code CLI
INSTALL_ANTIGRAVITY=false # Antigravity CLI (agy; replaces the retired Gemini CLI)

# SSH toggles
SSH_YUBIKEY=true        # WSL: relay Windows ssh-agent (YubiKey ed25519-sk) into WSL via socat+npiperelay
SSH_LOCAL=false          # decrypt the age-encrypted SSH private key to ~/.ssh/id_ed25519 (opt-in; most machines use the YubiKey relay or need no local key)

# Additional apt packages (space-separated)
MORE_APT_PACKAGES=""
