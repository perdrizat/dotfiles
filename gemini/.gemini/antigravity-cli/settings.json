{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "enableTelemetry": false,
  "model": "GPT-OSS 120B (Medium)",
  "permissions": {
    "allow": [
      "command(break)",
      "command(cat)",
      "command(cd)",
      "command(df)",
      "command(docker compose)",
      "command(docker logs)",
      "command(docker ps)",
      "command(echo)",
      "command(find)",
      "command(git checkout)",
      "command(git diff)",
      "command(git log)",
      "command(git status)",
      "command(grep)",
      "command(head)",
      "command(jq)",
      "command(ls)",
      "command(lsof)",
      "command(mkdir)",
      "command(pgrep)",
      "command(pnpm --version)",
      "command(pnpm -C client test)",
      "command(pnpm -C server add jsdom)",
      "command(pnpm audit)",
      "command(pnpm build)",
      "command(pnpm lint)",
      "command(pnpm rebuild)",
      "command(pnpm test)",
      "command(pnpm test:e2e)",
      "command(pnpm test:fast)",
      "command(pnpm test:uat)",
      "command(pnpm typecheck)",
      "command(pnpm verify)",
      "command(pre_commit_check.sh)",
      "command(ps)",
      "command(read)",
      "command(sleep)",
      "command(stat)",
      "command(strings)",
      "command(tail)",
      "command(touch)",
      "command(tr)",
      "command(validate_project.sh)",
      "command(validate_setup.sh)",
      "command(wc)",
      "command(which)",
      "command(~/bin/check_changelog.sh)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/agy_status.sh",
    "enabled": true
  },
  "title": {
    "command": "~/bin/agy_title.sh",
    "enabled": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/bin/check_changelog.sh"
          }
        ]
      }
    ]
  },
  "verbosity": "low"
}
