    "ask": [
      "command(gh auth)"
    ],
    "deny": [
      "read_file(.env)",
      "read_file(~/.aws)",
      "read_file(~/.claude/.credentials.json)",
      "read_file(~/.config/gh/hosts.yml)",
      "read_file(~/.gemini/antigravity-cli/antigravity-oauth-token)",
