      "read_file(~/.gnupg)",
      "read_file(~/.netrc)",
      "read_file(~/.ssh)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/agy_status.sh",
    "enabled": true
  },
  "title": {
    "command": "~/bin/agy_title.sh",
    "enabled": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/bin/check_changelog.sh"
          }
        ]
      }
    ]
  },
  "verbosity": "low"
